---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import SkipLink from "../components/layout/SkipLink.astro";
import ThemeScript from "../components/ThemeScript.astro";
import {
  appleTouchIconPath,
  homeSocialImage,
  ogImageSize,
  sitemapPath,
  type SocialImage,
} from "../data/seo";
import { site } from "../data/site";
import { themeColors } from "../data/theme";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  socialImage?: SocialImage;
}

const {
  title,
  description,
  noindex = false,
  socialImage = homeSocialImage,
} = Astro.props;
const canonicalUrl = noindex
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(socialImage.path, Astro.site);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={themeColors.light.bg}
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={themeColors.dark.bg}
    />
    <ThemeScript />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageSize.width)} />
    <meta property="og:image:height" content={String(ogImageSize.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href={appleTouchIconPath} />
    <link rel="sitemap" href={sitemapPath} />
    <slot name="head" />
    <Font cssVariable="--font-space-grotesk" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-jetbrains-mono" />
    <ClientRouter />
  </head>
  <body id="top">
    <SkipLink />
    <Navbar />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { setupFragmentFocus } from "../scripts/fragment-focus";
  import { startMotion } from "../scripts/motion/runtime";

  setupFragmentFocus();
  startMotion();
</script>
