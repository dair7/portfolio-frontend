---
import Button from "../components/ui/Button.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import Tag from "../components/ui/Tag.astro";
import ThemeToggle from "../components/ui/ThemeToggle.astro";
import StyleguideSection from "./StyleguideSection.astro";

const sampleTags = ["Java", "Spring Boot", "PostgreSQL", "React", "TypeScript"];
const tagVariants = ["neutral", "technology"] as const;
---

<StyleguideSection title="Components">
  <div class="space-y-8">
    <div class="flex flex-wrap items-center gap-3">
      <Button href="#">Link button</Button>
      <Button variant="secondary" href="#">
        Secondary link
      </Button>
      <Button>Native button</Button>
      <Button variant="secondary">Secondary</Button>
      <ThemeToggle />
    </div>
    {tagVariants.map((variant) => (
      <ul class="flex flex-wrap gap-2">
        {sampleTags.map((label) => (
          <li>
            <Tag label={label} variant={variant} />
          </li>
        ))}
      </ul>
    ))}
    <SectionHeading number="01" title="Selected work" level={3} />
    <div class="rounded-2xl bg-feature p-6 font-mono text-small">
      <p class="text-feature-muted">GET /api/projects/1</p>
      <p class="text-feature-text">
        <span class="text-feature-accent">"status"</span>: 200
      </p>
    </div>
  </div>
</StyleguideSection>
