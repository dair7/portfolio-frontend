---
import StyleguideSection from "./StyleguideSection.astro";
---

<StyleguideSection title="Type scale">
  <div class="space-y-6">
    <p class="font-display text-hero font-bold">Dair</p>
    <p class="font-display text-section font-bold">Selected work</p>
    <p class="font-display text-title font-medium">Title · Space Grotesk 500</p>
    <p class="max-w-reading text-body">
      Body · Inter 400. I build backends in Java and Spring Boot and the
      interfaces that use them in React and TypeScript.
    </p>
    <p class="text-body font-medium">Body · Inter 500</p>
    <p class="text-body font-semibold">Body · Inter 600</p>
    <p class="text-small text-muted">Small · 15 px muted</p>
    <p class="text-caption text-muted">Caption · 13 px minimum</p>
    <p class="font-mono text-small">GET /api/projects/1 · JetBrains Mono 400</p>
    <p class="font-mono text-small font-medium">JetBrains Mono 500</p>
  </div>
</StyleguideSection>
