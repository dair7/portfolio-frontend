---
import "../styles/global.css";

const title = "Dair Guerrero — Full stack developer";
const description =
  "Portfolio of Dair Guerrero, full stack developer. Version 2 is in progress.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="grid min-h-dvh place-items-center">
    <h1 class="text-2xl font-medium">v2 in progress</h1>
  </body>
</html>
