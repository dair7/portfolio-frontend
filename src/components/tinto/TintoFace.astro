---
import { tintoEyeGeometry, tintoEyes } from "../../data/tinto";
import { createUniqueId } from "../../lib/unique-id";

const { centerY, radius, pupilRadius, lidTop, lidHeight } = tintoEyeGeometry;
const lidWidth = radius * 2 + 2;
const eyes = tintoEyes.map(({ side, centerX }) => ({
  side,
  centerX,
  clipId: createUniqueId(`tinto-eye-${side}`),
}));
const cheeks = [
  { centerX: 78, centerY: 156 },
  { centerX: 142, centerY: 156 },
];
---

<g class="tinto-face">
  <defs>
    {eyes.map(({ centerX, clipId }) => (
      <clipPath id={clipId}>
        <circle cx={centerX} cy={centerY} r={radius} />
      </clipPath>
    ))}
  </defs>
  {eyes.map(({ centerX, clipId }) => (
    <g class="tinto-eye">
      <circle cx={centerX} cy={centerY} r={radius} fill="var(--tinto-eye)" />
      <circle
        class="tinto-pupil"
        cx={centerX}
        cy={centerY}
        r={pupilRadius}
        fill="var(--tinto-pupil)"
      />
      <g clip-path={`url(#${clipId})`}>
        <rect
          class="tinto-lid"
          x={centerX - lidWidth / 2}
          y={lidTop}
          width={lidWidth}
          height={lidHeight}
          fill="var(--tinto-cup)"
        />
        <rect
          class="tinto-blink"
          x={centerX - lidWidth / 2}
          y={lidTop}
          width={lidWidth}
          height="0"
          fill="var(--tinto-cup)"
        />
      </g>
    </g>
  ))}
  {cheeks.map(({ centerX, centerY: cheekY }) => (
    <ellipse
      cx={centerX}
      cy={cheekY}
      rx="8"
      ry="4.5"
      fill="var(--tinto-cheek)"
      opacity=".75"
    />
  ))}
  <path
    class="tinto-mouth-smile"
    d="M101 157 Q110 166 119 157"
    fill="none"
    stroke="var(--tinto-mouth)"
    stroke-width="3.5"
    stroke-linecap="round"
  />
  <ellipse
    class="tinto-mouth-surprised"
    cx="110"
    cy="161"
    rx="4.5"
    ry="5.5"
    fill="var(--tinto-mouth)"
  />
</g>
