---
import TintoFace from "./TintoFace.astro";
import { motionNames } from "../../data/motion";
import {
  tintoSparkles,
  tintoSteamPaths,
  tintoViewBox,
  type TintoMood,
} from "../../data/tinto";

interface Props {
  mood?: TintoMood;
  size: number;
  label?: string;
  class?: string;
}

const { mood = "idle", size, label, class: className } = Astro.props;
const { x, y, width, height } = tintoViewBox;
const viewBox = [x, y, width, height].join(" ");
const renderedHeight = Math.round((size * height) / width);
const accessibility = label
  ? { role: "img" as const, "aria-label": label }
  : { "aria-hidden": "true" as const };
---

<svg
  class:list={["tinto h-auto max-w-full", className]}
  data-mood={mood}
  data-motion={motionNames.tinto}
  viewBox={viewBox}
  width={size}
  height={renderedHeight}
  {...accessibility}
>
  <ellipse
    cx="110"
    cy="214"
    rx="70"
    ry="8"
    fill="var(--tinto-shadow)"
    opacity=".1"
  />
  <g class="tinto-figure">
    <g
      class="tinto-steam"
      fill="none"
      stroke="var(--tinto-steam)"
      stroke-width="4"
      stroke-linecap="round"
    >
      {tintoSteamPaths.map((path) => (
        <path d={path} />
      ))}
    </g>
    <ellipse
      cx="110"
      cy="204"
      rx="80"
      ry="13"
      fill="var(--tinto-saucer)"
      stroke="var(--tinto-saucer-edge)"
      stroke-width="2"
    />
    <ellipse cx="110" cy="201" rx="56" ry="7" fill="var(--tinto-saucer-well)" />
    <path
      d="M166 112 q36 0 32 34 q-4 30 -40 28"
      fill="none"
      stroke="var(--tinto-cup)"
      stroke-width="13"
      stroke-linecap="round"
    />
    <path
      d="M50 92 L170 92 L161 186 Q159 200 145 200 L75 200 Q61 200 59 186 Z"
      fill="var(--tinto-cup)"
    />
    <path
      d="M140 92 L170 92 L161 186 Q159 200 145 200 L138 200 Q150 150 140 92 Z"
      fill="var(--tinto-cup-shade)"
      opacity=".55"
    />
    <ellipse cx="110" cy="92" rx="60" ry="12" fill="var(--tinto-rim)" />
    <ellipse cx="110" cy="93" rx="52" ry="8" fill="var(--tinto-coffee)" />
    <ellipse
      cx="96"
      cy="91"
      rx="14"
      ry="2.5"
      fill="var(--tinto-coffee-shine)"
    />
    <g class="tinto-cap">
      <path d="M58 88 Q96 30 150 84 Z" fill="var(--tinto-cap)" />
      <rect
        x="54"
        y="80"
        width="104"
        height="11"
        rx="5.5"
        fill="var(--tinto-cap-trim)"
      />
      <circle cx="150" cy="70" r="9" fill="var(--tinto-cap-trim)" />
    </g>
    <TintoFace />
  </g>
  <text
    class="tinto-question tinto-glyph"
    x="176"
    y="70"
    font-size="34"
    fill="var(--tinto-accent)"
  >
    ?
  </text>
  <g class="tinto-zzz tinto-glyph" fill="var(--tinto-zzz)">
    <text x="166" y="58" font-size="22">
      z
    </text>
    <text x="184" y="38" font-size="16">
      z
    </text>
  </g>
  <g class="tinto-sparkles" fill="var(--tinto-accent)">
    {tintoSparkles.map(({ x: sparkleX, y: sparkleY, radius }) => (
      <circle cx={sparkleX} cy={sparkleY} r={radius} />
    ))}
  </g>
</svg>
