---
import type { HTMLAttributes } from "astro/types";

import { beanShape, beanViewBox } from "../../lib/bean";

type Props = HTMLAttributes<"span">;

const { class: className, ...attributes } = Astro.props;
const viewBox = `0 0 ${beanViewBox.width} ${beanViewBox.height}`;
---

<span class:list={["inline-block", className]} {...attributes}>
  <svg
    viewBox={viewBox}
    class="block h-[0.3em] w-auto"
    aria-hidden="true"
    focusable="false"
  >
    <g transform={beanShape.rotation}>
      <ellipse {...beanShape.body} fill="currentColor" />
      <path
        d={beanShape.crease}
        fill="none"
        stroke="var(--theme-bg)"
        stroke-width={beanShape.creaseWidth}
        stroke-linecap="round"
      />
    </g>
  </svg>
</span>
