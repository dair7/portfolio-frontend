---
import { okStatusLabel } from "../../data/brand";
import { motionNames } from "../../data/motion";
import type { Project } from "../../lib/projects";

type FlowStep = NonNullable<Project["data"]["flow"]>[number];
type FlowVariant = "compact" | "diagram";

interface Props {
  steps: FlowStep[];
  variant?: FlowVariant;
}

const { steps, variant = "compact" } = Astro.props;

const variantClasses: Record<
  FlowVariant,
  {
    list: string;
    item: string;
    step: string;
    layer: string;
    border: string;
    emphasis: string;
  }
> = {
  compact: {
    list: "space-y-1",
    item: "",
    step: "flex flex-wrap items-baseline gap-x-4",
    layer: "w-28 shrink-0",
    border: "",
    emphasis: "",
  },
  diagram: {
    list: "flex flex-col gap-2 xl:flex-row xl:items-stretch",
    item: "flex flex-col gap-2 xl:flex-1 xl:flex-row xl:items-center",
    step: "flex h-full min-w-0 flex-col gap-1 rounded-2xl border p-4 transition-colors duration-200 data-flow-active:bg-feature-accent/15 xl:flex-1",
    layer: "",
    border: "border-feature-muted/30",
    emphasis: "border-feature-accent",
  },
};

const classes = variantClasses[variant];
const isDiagram = variant === "diagram";
---

<div
  class="relative rounded-3xl bg-feature p-6 font-mono text-small sm:p-10"
  data-motion={isDiagram ? motionNames.requestFlow : undefined}
>
  {variant === "compact" && (
    <p class="mb-6 text-caption text-feature-muted">Request flow</p>
  )}
  <ol class={classes.list}>
    {steps.map(({ layer, label, emphasis }, index) => (
      <li class={classes.item}>
        {index > 0 && (
          <span
            aria-hidden="true"
            class:list={[
              "block pl-2 text-feature-accent",
              variant === "compact" ? "py-1" : "xl:pl-0",
            ]}
          >
            <span class:list={[isDiagram && "xl:hidden"]}>↓</span>
            {isDiagram && <span class="hidden xl:inline">→</span>}
          </span>
        )}
        <span
          data-flow-step={isDiagram ? "" : undefined}
          class:list={[
            classes.step,
            emphasis ? classes.emphasis : classes.border,
          ]}
        >
          <span class:list={[classes.layer, "text-caption text-feature-muted"]}>
            {layer}
          </span>
          <span class="text-feature-text">{label}</span>
        </span>
      </li>
    ))}
  </ol>
  {isDiagram && (
    <p
      data-flow-status
      class="mt-6 text-feature-muted transition-colors duration-200 data-flow-active:text-feature-accent"
    >
      <span aria-hidden="true">← </span>
      {okStatusLabel}
    </p>
  )}
</div>
