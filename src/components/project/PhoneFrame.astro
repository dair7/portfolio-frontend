---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  image: ImageMetadata;
  alt: string;
  loading: "eager" | "lazy";
}

const { image, alt, loading } = Astro.props;
---

<div class="grid h-full w-full place-items-center bg-band p-4">
  <div class="aspect-9/19 h-full overflow-hidden rounded-[1.5rem] border-[5px] border-text bg-surface shadow-lg">
    <Picture
      src={image}
      alt={alt}
      formats={["avif", "webp"]}
      widths={[240, 480]}
      sizes="12rem"
      loading={loading}
      class="h-full w-full object-cover object-top"
    />
  </div>
</div>
