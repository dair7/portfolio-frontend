---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label="Switch color theme"
  class:list={[
    "inline-flex size-11 items-center justify-center rounded-full border border-line text-text transition-colors duration-200 hover:bg-surface",
    className,
  ]}
>
  <svg
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script>
  import { themeStorageKey, type Theme } from "../../data/theme";
  import { transitionTheme } from "../../scripts/theme-transition";

  const toggleSelector = "[data-theme-toggle]";

  function currentTheme(): Theme {
    return document.documentElement.dataset.theme === "dark" ? "dark" : "light";
  }

  function oppositeOf(theme: Theme): Theme {
    return theme === "dark" ? "light" : "dark";
  }

  function syncToggleLabels(): void {
    const label = `Switch to ${oppositeOf(currentTheme())} theme`;
    for (const toggle of document.querySelectorAll(toggleSelector)) {
      toggle.setAttribute("aria-label", label);
    }
  }

  function storeTheme(theme: Theme): void {
    // Storage can throw in private modes; the theme still applies for this visit.
    try {
      localStorage.setItem(themeStorageKey, theme);
    } catch {
      return;
    }
  }

  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme;
    storeTheme(theme);
    syncToggleLabels();
  }

  document.addEventListener("click", (event) => {
    const toggle =
      event.target instanceof Element && event.target.closest(toggleSelector);
    if (toggle) {
      const nextTheme = oppositeOf(currentTheme());
      transitionTheme(toggle, () => applyTheme(nextTheme));
    }
  });
  document.addEventListener("astro:page-load", syncToggleLabels);
</script>
