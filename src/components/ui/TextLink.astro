---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a"> & { href: string };

const { class: className, ...attributes } = Astro.props;
---

<a
  class:list={[
    "inline-flex min-h-11 items-center font-medium text-text underline decoration-1 underline-offset-4 hover:decoration-2",
    className,
  ]}
  {...attributes}
>
  <slot />
</a>
