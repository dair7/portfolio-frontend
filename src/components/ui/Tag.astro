---
type TagVariant = "neutral" | "technology";

interface Props {
  label: string;
  variant?: TagVariant;
}

const { label, variant = "neutral" } = Astro.props;

const variantClasses: Record<TagVariant, string> = {
  neutral: "border-line bg-surface text-text",
  technology: "border-accent/45 bg-accent/12 font-medium text-accent-text",
};
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-3 py-1 font-mono text-caption",
    variantClasses[variant],
  ]}
>
  {label}
</span>
