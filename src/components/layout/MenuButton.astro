---
interface Props {
  controls: string;
}

const { controls } = Astro.props;
---

<button
  type="button"
  data-menu-button
  aria-controls={controls}
  aria-expanded="false"
  aria-label="Menu"
  class="group inline-flex size-11 items-center justify-center rounded-full border border-line text-text transition-colors duration-200 hover:bg-surface md:hidden"
>
  <svg
    class="size-5 group-aria-expanded:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M4 7h16M4 12h16M4 17h16"></path>
  </svg>
  <svg
    class="hidden size-5 group-aria-expanded:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <path d="M6 6l12 12M18 6L6 18"></path>
  </svg>
</button>
