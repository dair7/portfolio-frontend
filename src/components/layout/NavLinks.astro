---
import { motionNames } from "../../data/motion";
import { navigationLinks, sectionHref } from "../../data/navigation";

type NavLinksVariant = "desktop" | "mobile";

interface Props {
  variant: NavLinksVariant;
}

const { variant } = Astro.props;
const currentPath = Astro.url.pathname;

const listClasses: Record<NavLinksVariant, string> = {
  desktop: "flex items-center gap-2",
  mobile: "flex flex-col",
};

const linkClasses: Record<NavLinksVariant, string> = {
  desktop: "px-4 text-nav",
  mobile: "px-4 text-body",
};
---

<ul class={listClasses[variant]}>
  {navigationLinks.map(({ label, sectionId }) => (
    <li>
      <a
        href={sectionHref(sectionId, currentPath)}
        data-nav-link={sectionId}
        data-motion={motionNames.wave}
        class:list={[
          "group/nav flex min-h-11 items-center rounded-full font-medium text-text",
          linkClasses[variant],
        ]}
      >
        <span class="relative after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:bg-current after:opacity-0 group-hover/nav:after:opacity-100 group-aria-[current=true]/nav:after:bg-accent group-aria-[current=true]/nav:after:opacity-100">
          {label}
        </span>
      </a>
    </li>
  ))}
</ul>
