---
import Button from "../ui/Button.astro";
import NavLinks from "./NavLinks.astro";
import { resumeHref } from "../../data/navigation";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div
  id={id}
  hidden
  data-mobile-menu
  class="glass absolute inset-x-0 top-full mt-2 rounded-3xl p-3 md:hidden"
>
  <nav aria-label="Main">
    <NavLinks variant="mobile" />
  </nav>
  <div class="mt-2 border-t border-glass-line px-1 pt-3">
    <Button
      variant="secondary"
      href={resumeHref}
      data-astro-reload
      class="w-full"
    >
      Résumé
    </Button>
  </div>
</div>
