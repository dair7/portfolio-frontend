---
import { logoLabel, logoParts } from "../../data/brand";
import { motionNames, motionSessions } from "../../data/motion";
import { homePath } from "../../data/navigation";

type LogoMotion = "decode" | "wave";

interface Props {
  motion: LogoMotion;
  class?: string;
}

const { motion, class: className } = Astro.props;
const isNavLogo = motion === "decode";
const decodeAttributes = isNavLogo
  ? {
      "data-motion": motionNames.decode,
      "data-motion-once": motionSessions.navLogo,
      "data-motion-accent": "text-accent",
    }
  : {};
---

<a
  href={homePath}
  aria-label={logoLabel}
  data-motion={isNavLogo ? undefined : motionNames.wave}
  class:list={[
    "group/logo inline-flex min-h-11 items-center rounded-full px-2 font-display text-title font-bold text-text",
    className,
  ]}
>
  <span {...decodeAttributes}>{logoParts.name}</span>
  <span
    data-logo-dot={isNavLogo ? "" : undefined}
    class:list={[
      "inline-block text-accent",
      isNavLogo && "logo-dot motion-safe:data-bouncing:animate-dot-bounce",
    ]}
  >
    <span
      class:list={[
        "inline-block",
        isNavLogo &&
          "logo-dot motion-safe:group-hover/logo:animate-dot-squash motion-safe:group-focus-visible/logo:animate-dot-squash",
      ]}
    >
      {logoParts.dot}
    </span>
  </span>
  <span {...decodeAttributes}>{logoParts.suffix}</span>
</a>
