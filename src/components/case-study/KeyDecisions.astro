---
import PageSection from "../ui/PageSection.astro";
import { formatProjectNumber, type Project } from "../../lib/projects";

interface Props {
  decisions: Project["data"]["decisions"];
}

const { decisions } = Astro.props;
---

<PageSection id="decisions" title="Key decisions">
  <ol class="grid gap-6 md:grid-cols-2">
    {decisions.map(({ title, body }, index) => (
      <li class="space-y-4 rounded-3xl border border-line bg-surface p-6 sm:p-8">
        <span
          aria-hidden="true"
          class="block font-display text-headline font-medium text-accent"
        >
          {formatProjectNumber(index)}
        </span>
        <h3 class="text-title">{title}</h3>
        <p class="text-body text-muted">{body}</p>
      </li>
    ))}
  </ol>
</PageSection>
