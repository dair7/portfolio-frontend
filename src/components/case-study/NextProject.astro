---
import BackdropBlobs from "../decor/BackdropBlobs.astro";
import Container from "../ui/Container.astro";
import LinkArrow from "../ui/LinkArrow.astro";
import type { Project } from "../../lib/projects";

interface Props {
  nextProject: Project;
}

const { nextProject } = Astro.props;
const caseStudyContext = `about ${nextProject.data.title}`;
---

<div class="relative isolate overflow-x-clip">
  <Container class="py-16 sm:py-20">
    <div class="group space-y-4 glass glass-shine rounded-3xl p-8 hover:border-text sm:p-10">
      <p class="text-small text-muted">Next project</p>
      <p class="font-display text-headline font-bold">
        {nextProject.data.title}
      </p>
      <p class="max-w-reading text-body text-muted">
        {nextProject.data.summary}
      </p>
      <a
        href={`/projects/${nextProject.id}`}
        class="group/arrow inline-block font-medium underline decoration-1 underline-offset-4 group-hover:decoration-2 after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-accent"
      >
        Read the case study <span class="sr-only">{caseStudyContext}</span>
        <LinkArrow />
      </a>
    </div>
  </Container>
  <BackdropBlobs placement="center" />
</div>
