---
import TextLink from "../ui/TextLink.astro";
import type { OpenSourceHighlight } from "../../data/oss-highlights";

interface Props {
  highlight: OpenSourceHighlight;
}

const { organization, repository, number, url, title, note } =
  Astro.props.highlight;
const repositoryPath = `${organization}/${repository}`;
const pullRequestLabel = `PR #${number}`;
---

<article class="flex h-full flex-col gap-4 glass glass-shine rounded-3xl p-6">
  <p class="font-mono text-caption break-words text-muted">{repositoryPath}</p>
  <h3 class="text-title">{title}</h3>
  <p class="text-small text-muted">{note}</p>
  <TextLink href={url} class="mt-auto text-small">
    {pullRequestLabel}
    <span class="sr-only"> in {repository}</span>
    <span aria-hidden="true">&nbsp;↗</span>
  </TextLink>
</article>
