---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import PendingText from "../ui/PendingText.astro";
import PageSection from "../ui/PageSection.astro";
import StackRows from "./StackRows.astro";
import { sectionIds } from "../../data/navigation";
import { site } from "../../data/site";

const photoModules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/photo.jpg",
  { eager: true },
);
const photo = Object.values(photoModules)[0]?.default;
---

<PageSection id={sectionIds.about} title="About" isNavigationTarget>
  <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-16">
    {photo ? (
      <Image
        src={photo}
        alt={`Portrait of ${site.name}`}
        widths={[320, 640]}
        sizes="(min-width: 64rem) 20rem, 100vw"
        class="aspect-[4/5] w-full max-w-80 rounded-3xl object-cover"
      />
    ) : (
      <div class="grid aspect-[4/5] w-full max-w-80 place-items-center rounded-3xl border-2 border-dashed border-line p-6 text-center">
        <PendingText value="TODO(dair): add your photo at src/assets/photo.jpg" />
      </div>
    )}
    <div class="space-y-10">
      <p class="max-w-reading text-body text-text">{site.bio}</p>
      <StackRows />
    </div>
  </div>
</PageSection>
