---
import type { Project } from "../../lib/projects";

type FlowStep = NonNullable<Project["data"]["flow"]>[number];

interface Props {
  steps: FlowStep[];
}

const { steps } = Astro.props;
---

<div class="rounded-3xl bg-feature p-6 font-mono text-small sm:p-10">
  <p class="mb-6 text-caption text-feature-muted">Request flow</p>
  <ol class="space-y-1">
    {steps.map(({ layer, label }, index) => (
      <li>
        {index > 0 && (
          <span aria-hidden="true" class="block py-1 pl-2 text-feature-accent">
            ↓
          </span>
        )}
        <span class="flex flex-wrap items-baseline gap-x-4">
          <span class="w-28 shrink-0 text-caption text-feature-muted">
            {layer}
          </span>
          <span class="text-feature-text">{label}</span>
        </span>
      </li>
    ))}
  </ol>
</div>
