---
import PageSection from "../ui/PageSection.astro";
import ProjectFeature from "./ProjectFeature.astro";
import { sectionIds } from "../../data/navigation";
import { formatProjectNumber, getPublishedProjects } from "../../lib/projects";

const projects = await getPublishedProjects();
---

<PageSection id={sectionIds.work} title="Selected work" isNavigationTarget>
  <ol class="space-y-14 lg:space-y-20">
    {projects.map((project, index) => (
      <li>
        <ProjectFeature
          project={project}
          number={formatProjectNumber(index)}
          reversed={index % 2 === 1}
        />
      </li>
    ))}
  </ol>
</PageSection>
