---
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  id: string;
  title: string;
  lead?: string;
  band?: boolean;
}

const { id, title, lead, band = false } = Astro.props;
const titleId = `${id}-title`;
---

<section
  id={id}
  tabindex="-1"
  aria-labelledby={titleId}
  class:list={["py-24 sm:py-32", band && "bg-band"]}
>
  <Container class="space-y-12">
    <div class="space-y-4">
      <SectionHeading id={titleId} title={title} />
      {lead && <p class="max-w-reading text-body text-muted">{lead}</p>}
    </div>
    <slot />
  </Container>
</section>
